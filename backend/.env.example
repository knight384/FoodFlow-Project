# Backend environment configuration template.
# Copy this file to `.env` for local development. Never commit the real `.env` file.
# See TRD v1.0 Section 21 (Configuration and Environment Strategy).

# One of: development | test | production
APP_ENVIRONMENT=development

# PostgreSQL connection string.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# The values below match docker-compose.yml's local dev database (see repo root).
DATABASE_URL=postgresql+psycopg://foodflow_app:foodflow_app@localhost:5432/foodflow_dev

# Comma-separated list of origins allowed to call this API (local frontend dev server).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Authentication (Phase 3) ---
# Secret key used to sign JWT access tokens. MUST be a long, random,
# unique value outside local development — never reuse the example
# below anywhere but your own local machine.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
